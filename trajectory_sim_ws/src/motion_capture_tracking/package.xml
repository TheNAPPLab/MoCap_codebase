<?xml version="1.0"?>
<package format="3">
  <name>motion_capture_tracking</name>
  <version>0.0.1</version>
  <description>Trajectory generation and path publishing nodes</description>

  <maintainer email="timothy.churhillr@gmail.com">Timothy Churchill</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS build dependencies -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- Python dependencies (required if installed via rosdep) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

</package>
